        ]
      },
      {
        "name": "Date",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "formatString": "yyyy-MM-dd",
            "isKey": true,
            "isNameInferred": true,
            "lineageTag": "20ef8311-72e8-43ee-9a5b-1b003e2503db",
            "sourceColumn": "[Date]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Year",
            "dataType": "int64",
            "expression": "YEAR('Date'[Date])",
            "lineageTag": "7fb7ff2d-9e63-473a-9190-7ce1aed99fff",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Month",
            "dataType": "string",
            "expression": "FORMAT('Date'[Date], \"yyyy-MM\")",
            "lineageTag": "eeef03dc-e597-41d7-9eab-85db1ade3760",
            "sortByColumn": "MonthIndex",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "MonthIndex",
            "dataType": "int64",
            "expression": "YEAR('Date'[Date]) * 100 + MONTH('Date'[Date])",
            "isHidden": true,
            "lineageTag": "0db0b628-29d8-4fd7-9100-5d99e1f88944",
            "summarizeBy": "none",
