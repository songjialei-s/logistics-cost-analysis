            "summarizeBy": "none"
          },
          {
            "name": "is_anomaly",
            "dataType": "int64",
            "lineageTag": "52742586-db1b-4a60-bcd7-0bd17d948d93",
            "sourceColumn": "is_anomaly",
            "summarizeBy": "none"
          },
          {
            "name": "amount",
            "dataType": "double",
            "isHidden": true,
            "lineageTag": "27e57f5b-86c2-4fdf-a4a7-32536f37d1b7",
            "sourceColumn": "amount",
            "summarizeBy": "none"
          },
          {
            "name": "amount_cny",
            "dataType": "double",
            "isHidden": true,
            "lineageTag": "3f5cc114-cb99-46f5-8998-7bec3479f865",
            "sourceColumn": "amount_cny",
            "summarizeBy": "none"
          },
          {
            "name": "parcel_key",
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "cdcc8221-a97a-4817-906b-c0960c403e77",
            "sourceColumn": "parcel_key",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "9eafd416-61ba-4548-9b7b-2e6c31aac054",
        "measures": [
          {
            "name": "Total Cost CNY",
            "description": "Selected charge cost, in fictional CNY.",
            "expression": "DIVIDE(SUM(charges[amount_cny_minor]), 100)",
            "formatString": "#,0.00",
            "lineageTag": "6b2c028a-3e9d-4b27-9ae3-ebd23516cf5c"
          },
          {
            "name": "Freight CNY",
            "description": "Freight in current scope; handling-only selection gives blank.",
            "expression": "CALCULATE([Total Cost CNY], KEEPFILTERS(charges[category] = \"freight\"))",
            "formatString": "#,0.00",
            "lineageTag": "f0e549e1-6771-464b-95c2-928a4a0fa12c"
          },
          {
            "name": "Parcels",
            "description": "Date/provider filtered parcels; category does not reduce this denominator.",
            "expression": "COUNTROWS(parcels)",
            "formatString": "#,0",
            "lineageTag": "8f336a0a-5817-49da-83c1-e2a7247c52f5"
          },
          {
            "name": "Items",
            "description": "Each parcel counted once. Not summed on charges.",
            "expression": "SUM(parcels[item_count])",
            "formatString": "#,0",
            "lineageTag": "6b2759fc-4cfd-4b3f-a59c-e07bd46bd9d6"
          },
          {
            "name": "Cost per Parcel CNY",
            "description": "Selected category cost per all date/provider selected parcels.",
            "expression": "DIVIDE([Total Cost CNY], [Parcels])",
            "formatString": "#,0.00",
            "lineageTag": "9d0a589f-bed7-4e59-8bd9-50802c8e9882"
          },
          {
            "name": "Cost per Item CNY",
            "description": "Selected category cost per all date/provider selected items.",
            "expression": "DIVIDE([Total Cost CNY], [Items])",
            "formatString": "#,0.00",
            "lineageTag": "939555c1-082c-4098-9596-de57edcea459"
          },
          {
            "name": "Freight per Parcel CNY",
            "description": "Every fixture parcel has freight, matching SQL freight-bearing denominator.",
            "expression": "DIVIDE([Freight CNY], [Parcels])",
            "formatString": "#,0.00",
            "lineageTag": "436956ae-cfa4-402e-a4e5-557388bd134d"
          },
          {
            "name": "Freight per Item CNY",
            "description": "Matches SQL for this fixture; see coverage check.",
            "expression": "DIVIDE([Freight CNY], [Items])",
            "formatString": "#,0.00",
            "lineageTag": "fdc58890-9c86-4df5-a68d-5f62bbbbb361"
          },
          {
            "name": "Previous Month Cost CNY",
            "description": "Previous calendar month in current provider/category context.",
            "expression": "CALCULATE([Total Cost CNY], DATEADD('Date'[Date], -1, MONTH))",
            "formatString": "#,0.00",
            "lineageTag": "b802440e-b68a-420f-8434-670bd9c69ef4"
          },
          {
            "name": "Cost MoM",
            "description": "Blank for missing previous month or zero denominator.",
            "expression": "VAR Prior = [Previous Month Cost CNY] RETURN IF(NOT ISINSCOPE('Date'[Month]) || ISBLANK([Total Cost CNY]), BLANK(), DIVIDE([Total Cost CNY] - Prior, Prior))",
            "formatString": "0.0%",
            "lineageTag": "a29f91ab-bd66-4736-b5ac-6320716fd7ff"
          },
          {
            "name": "Category Share",
            "description": "Share of all categories, retaining date/provider filters.",
            "expression": "DIVIDE([Total Cost CNY], CALCULATE([Total Cost CNY], REMOVEFILTERS(charges[category])))",
            "formatString": "0.0%",
            "lineageTag": "32b6f323-cda0-463b-b6c2-e8357ae21c0d"
          },
          {
            "name": "Charge Lines",
            "description": "Accepted fee lines in selected scope.",
            "expression": "COUNTROWS(charges)",
            "formatString": "#,0",
            "lineageTag": "78c6b246-3a90-44f1-ae92-b57715605528"
          },
          {
            "name": "Review Charge Lines",
            "description": "Charge >400 fictional CNY; not a proven billing error.",
            "expression": "COALESCE(CALCULATE(COUNTROWS(charges), KEEPFILTERS(charges[is_anomaly] = 1)), 0)",
            "formatString": "#,0",
            "lineageTag": "c0edec57-ce36-4949-bfad-0cb9dd8b12cc"
          },
          {
            "name": "Review Cost CNY",
            "description": "Flagged charge amount, not demonstrated savings.",
            "expression": "CALCULATE([Total Cost CNY], KEEPFILTERS(charges[is_anomaly] = 1))",
            "formatString": "#,0.00",
            "lineageTag": "cfc4333c-0cf1-4cf4-9620-eb5697d7aa24"
          },
          {
            "name": "Rejected Rows All Data",
            "description": "Global rejected snapshot. No date/provider/category filtering.",
            "expression": "COUNTROWS(rejected)",
            "formatString": "#,0",
            "lineageTag": "ca036f57-7470-44ac-a645-e7716c4e60b7"
          },
          {
            "name": "Freight Coverage Parcels",
            "description": "Should equal Parcels under date/provider filters for this fixture.",
            "expression": "CALCULATE(DISTINCTCOUNT(charges[parcel_key]), REMOVEFILTERS(charges[category]), charges[category] = \"freight\")",
            "formatString": "#,0",
            "lineageTag": "22a1b0d0-2a8a-48a6-b0c6-81030c34346e"
          }
        ],
        "partitions": [
          {
            "name": "charges",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/charges.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"provider\", type text}, {\"tracking_id\", type text}, {\"ship_date\", type date}, {\"category\", type text}, {\"currency\", type text}, {\"amount_minor\", Int64.Type}, {\"fx_rate\", type number}, {\"amount_cny_minor\", Int64.Type}, {\"weight_kg\", type number}, {\"item_count\", Int64.Type}, {\"source_file\", type text}, {\"source_row\", Int64.Type}, {\"is_anomaly\", Int64.Type}, {\"amount\", type number}, {\"amount_cny\", type number}}, \"en-US\"),",
                "    Keyed = Table.AddColumn(Typed, \"parcel_key\", each Text.Combine({[provider], [tracking_id], Date.ToText([ship_date], \"yyyy-MM-dd\")}, \"|\"), type text)",
                "in",
                "    Keyed"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "parcels",
        "columns": [
          {
