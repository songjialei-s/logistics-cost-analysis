          }
        ],
        "expression": "\"D:/GitHubProjects/logistics-cost-analysis/data/demo\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "kind": "m",
        "lineageTag": "eb332529-3df0-4028-8d5d-133e9a7527a1"
      }
